#!/bin/sh
# postinst script for sefazba (customized from jpackage's template: adds the sefazba terminal command)

set -e

case "$1" in
    configure)
        xdg-desktop-menu install /opt/sefazba/lib/sefazba-SefazBa.desktop
        ln -sf /opt/sefazba/bin/SefazBa /usr/bin/sefazba
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
